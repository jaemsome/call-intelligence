# Supabase (server-only — never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — LLM_PROVIDER is anthropic, groq, or auto
# auto: calls up to LLM_AUTO_GROQ_MAX_SEC (default 540 = 9 min) use Groq, longer calls use Claude.
# auto falls back to whichever of GROQ_API_KEY / ANTHROPIC_API_KEY is set.
DEEPGRAM_API_KEY=
LLM_PROVIDER=anthropic
LLM_AUTO_GROQ_MAX_SEC=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: claude-haiku-5-5 / openai/gpt-oss-120b)
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Rate limiting (optional locally — falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Seeding (local only)
SEED_AUDIO_DIR=PestLaunch Instructions/02 — Call Recordings (20)
